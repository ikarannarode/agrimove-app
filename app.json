{
  "expo": {
    "name": "Smart Krushi Malvahatuk Vyavasthapan Pranali",
    "slug": "agrimove",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agrimove",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartkrushi.malvahatuk"
    },
    "android": {
      "package": "com.smartkrushi.malvahatuk",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "QR कोड आणि पेमेंटचा स्क्रीनशॉट निवडण्यासाठी फोटो लायब्ररी वापरा.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "नकाशावर pickup किंवा destination निवडताना सध्याचे स्थान केंद्र म्हणून वापरण्यास परवानगी द्या."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
